+/* clack: Go can't preempt wasm code (wazero's compiled code has no safe
+   points), so a Go stop-the-world (each Go GC cycle, ReadMemStats,
+   runtime.Stack) waits until this thread next calls the host, with every
+   goroutine paused, the UI's too. Bytecode calls the interrupt handler
+   every JS_INTERRUPT_COUNTER_INIT steps, but QuickJS's own C loops (the
+   cycle collector, JSON, allocation-heavy builtins, joins, sorts) call
+   nothing. They call js_yield_tick, and every clack_yield_every ticks
+   clack_yield (glue.c) makes a host call that does nothing but give Go
+   its chance. A tick is about one object visited or one allocation (well
+   under a microsecond), so 10000 ticks is a millisecond or so. */
+void clack_yield(void);
+void clack_gc(int phase, uint32_t objects, size_t heap);
+static int clack_yield_every = 10000;
+static int clack_yield_left = 10000;
+static uint32_t clack_gc_objects;
+
+static no_inline void js_yield_slow(void)
+{
+    clack_yield_left = clack_yield_every;
+    clack_yield();
+}
+
+static inline void js_yield_tick(void)
+{
+    if (unlikely(--clack_yield_left <= 0))
+        js_yield_slow();
+}
+
+/* clack: ticks between yields; n <= 0 turns them off (to measure them) */
+void JS_ClackSetYield(int n)
+{
+    clack_yield_every = n > 0 ? n : INT32_MAX;
+    clack_yield_left = clack_yield_every;
+}
+
+/* clack: O(1) heap figures (JS_ComputeMemoryUsage walks the whole heap) */
+size_t JS_ClackMallocSize(JSRuntime *rt)
+{
+    return rt->malloc_state.malloc_size;
+}
+
+size_t JS_ClackMallocCount(JSRuntime *rt)
+{
+    return rt->malloc_state.malloc_count;
+}
