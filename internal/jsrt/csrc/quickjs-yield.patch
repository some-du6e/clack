+/* clack: Go can't preempt wasm code (wazero's compiled code has no safe
+   points), so a Go stop-the-world (each Go GC cycle, ReadMemStats,
+   runtime.Stack) waits until this thread next calls the host, with every
+   goroutine paused, the UI's too. Bytecode calls the interrupt handler
+   every JS_INTERRUPT_COUNTER_INIT steps, but QuickJS's own C loops (the
+   cycle collector, JSON, allocation-heavy builtins, the array, typed
+   array and string builtins' loops) call nothing. They call
+   js_yield_tick, and every clack_yield_every ticks clack_yield (glue.c)
+   makes a host call that does nothing but give Go its chance. A tick is
+   about one object visited, one allocation or one array element (well
+   under a microsecond); a loop over raw memory ticks once per 16
+   elements or 64 bytes. So 10000 ticks is a millisecond or so. */
+void clack_yield(void);
+void clack_gc(int phase, uint32_t objects, size_t heap);
+static int clack_yield_every = 10000;
+static int clack_yield_left = 10000;
+static uint32_t clack_gc_objects;
+
+static no_inline void js_yield_slow(void)
+{
+    clack_yield_left = clack_yield_every;
+    clack_yield();
+}
+
+static inline void js_yield_tick(void)
+{
+    if (unlikely(--clack_yield_left <= 0))
+        js_yield_slow();
+}
+
+/* clack: n ticks at once, for a step worth n ordinary ones (a block of
+   memory copied, a string compared at one position) */
+static inline void js_yield_ticks(int n)
+{
+    clack_yield_left -= n;
+    if (unlikely(clack_yield_left <= 0))
+        js_yield_slow();
+}
+
+/* clack: a tight loop over raw elements (a typed array's, a string's
+   characters: a load, a store or a compare each, a nanosecond or so)
+   ticks once per 16 iterations of i, which is evaluated once. i must
+   take every value in turn: an index that skips (string_getc steps two
+   over a surrogate pair) can miss every multiple of 16, so such a loop
+   counts its iterations apart. */
+#define js_yield_tick_every16(i) \
+    do { if (unlikely(((i) & 15) == 0)) js_yield_tick(); } while (0)
+
+/* clack: memmove, memset and memchr in 64 KiB pieces with a tick per 64
+   bytes: over a typed array or ArrayBuffer of hundreds of MB, one call
+   is otherwise a single long stretch without a host call */
+#define CLACK_PIECE ((size_t)64 << 10)
+
+static void js_yield_memmove(void *dst, const void *src, size_t n)
+{
+    uint8_t *d = dst;
+    const uint8_t *s = src;
+    size_t k;
+
+    if (n == 0)
+        return;
+    if ((uintptr_t)d <= (uintptr_t)s) {
+        while (n > 0) {
+            k = n < CLACK_PIECE ? n : CLACK_PIECE;
+            memmove(d, s, k);
+            d += k;
+            s += k;
+            n -= k;
+            js_yield_ticks((int)(k >> 6));
+        }
+    } else {
+        /* back to front: an overlapping move reads each byte before it
+           is overwritten */
+        d += n;
+        s += n;
+        while (n > 0) {
+            k = n < CLACK_PIECE ? n : CLACK_PIECE;
+            d -= k;
+            s -= k;
+            memmove(d, s, k);
+            n -= k;
+            js_yield_ticks((int)(k >> 6));
+        }
+    }
+}
+
+static void js_yield_memset(void *dst, int c, size_t n)
+{
+    uint8_t *d = dst;
+    size_t k;
+
+    while (n > 0) {
+        k = n < CLACK_PIECE ? n : CLACK_PIECE;
+        memset(d, c, k);
+        d += k;
+        n -= k;
+        js_yield_ticks((int)(k >> 6));
+    }
+}
+
+static const void *js_yield_memchr(const void *buf, int c, size_t n)
+{
+    const uint8_t *s = buf;
+    const void *r;
+    size_t k;
+
+    while (n > 0) {
+        k = n < CLACK_PIECE ? n : CLACK_PIECE;
+        r = memchr(s, c, k);
+        if (r)
+            return r;
+        s += k;
+        n -= k;
+        js_yield_ticks((int)(k >> 6));
+    }
+    return NULL;
+}
+
+/* clack: ticks between yields; n <= 0 turns them off (to measure them) */
+void JS_ClackSetYield(int n)
+{
+    clack_yield_every = n > 0 ? n : INT32_MAX;
+    clack_yield_left = clack_yield_every;
+}
