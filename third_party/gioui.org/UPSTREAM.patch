diff --git a/gpu/internal/rendertest/render_test.go b/gpu/internal/rendertest/render_test.go
index 18b9ad6..15fc885 100644
--- a/gpu/internal/rendertest/render_test.go
+++ b/gpu/internal/rendertest/render_test.go
@@ -504,3 +504,26 @@ func lerp(a, b f32color.RGBA, p float32) f32color.RGBA {
 		A: a.A*(1-p) + b.A*p,
 	}
 }
+
+func TestOpaqueFillAfterOpacityLayer(t *testing.T) {
+	run(t, func(ops *op.Ops) {
+		// More ops before the layer than after the fill below, so a stale
+		// layer range indexes past the remaining ops.
+		for i := range 8 {
+			paint.FillShape(ops, red, clip.Rect(image.Rect(i*16, 0, i*16+8, 8)).Op())
+		}
+		opc := paint.PushOpacity(ops, .5)
+		paint.FillShape(ops, green, clip.Rect(image.Rect(16, 16, 48, 48)).Op())
+		opc.Pop()
+		// Fill screen to exercise the glClear optimization: the ops and
+		// opacity layers above are covered and dropped.
+		paint.FillShape(ops, blue, clip.Rect{Max: image.Pt(128, 128)}.Op())
+		opc = paint.PushOpacity(ops, .5)
+		paint.FillShape(ops, white, clip.Rect(image.Rect(64, 64, 96, 96)).Op())
+		opc.Pop()
+	}, func(r result) {
+		r.expect(4, 4, colornames.Blue)
+		r.expect(32, 32, colornames.Blue)
+		r.expect(120, 120, colornames.Blue)
+	})
+}
